{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emacs-docs",
  "compatibility_date": "2026-10-24",
  "preview_urls": true,
  // The committed landing shell, used for local `wrangler dev`. The generated
  // pages come from the Nix build (package.nix) and are not part of this
  // directory: the deploy (justfile, .github/workflows/emacs-docs.yml) passes
  // `--assets` pointing at the Nix result. The docs.example.org custom domain is
  // bound by the infra engine from project.nix `requires.dns`.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
