{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emacs-docs",
  "compatibility_date": "2026-10-24",
  "preview_urls": true,
  // The committed landing shell. The generated pages come from `nix build .#site`
  // and are not part of this directory: the deploy (Justfile, deploy.yml) passes
  // `--assets` pointing at a copy of the Nix result.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // The custom domain, bound from here on each deploy.
  "routes": [{ "pattern": "emacs.j10s.io", "custom_domain": true }]
}
