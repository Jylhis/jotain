{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emacs-docs",
  "compatibility_date": "2026-10-24",
  "preview_urls": true,
  // The committed landing shell, used for local `wrangler dev`. The generated
  // pages come from the Nix build (package.nix) and are not part of this
  // directory: the deploy (justfile, .github/workflows/emacs-docs.yml) passes
  // `--assets` pointing at the Nix result.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // The custom domain. The infra engine does not bind it (project.nix
  // `deploy.provision = false`), so each deploy binds it from here.
  "routes": [{ "pattern": "docs.example.org", "custom_domain": true }]
}
