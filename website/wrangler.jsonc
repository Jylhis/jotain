{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jotain-site",
  "compatibility_date": "2026-10-24",
  "preview_urls": true,
  // The committed landing shell. The generated pages come from the Nix build
  // (package.nix) and are not part of this directory.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
