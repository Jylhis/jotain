root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 100

[{website/public/**,flake.lock,nix/likec4-lsp/package-lock.json}]
charset = unset
end_of_line = unset
insert_final_newline = unset
max_line_length = unset

[*.{golden,snap,patch,diff}]
charset = unset
end_of_line = unset
insert_final_newline = unset
max_line_length = unset

[**/{testdata,fixtures}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
max_line_length = unset
