;;; jotain-lang-doc.el --- Render the language-support doc from the registry -*- lexical-binding: t; -*-

;;; Commentary:

;; Renders `jotain-lang-registry' into the checked-in language-support reference
;; (docs/reference/language-support.mdx).  This is the *declared* matrix: it
;; reflects what the registry says each language is wired for, and needs neither
;; the config nor any language toolchain, so it is cheap and fully
;; deterministic — which is what lets it be committed and gated by an in-sync
;; check (nix/lang-eval.nix `lang-eval-doc-in-sync'), the same discipline as
;; `packages-doc-in-sync'.
;;
;; The richer *live* matrices — actual mode routing and on-PATH markers
;; (Tier-1, `jotain-lang-eval.el') and real LSP round-trips (Tier-2,
;; `jotain-lang-live.el') — are build artifacts, not committed, because they
;; depend on the built distribution and on servers being present.
;;
;; Batch entry point (used by nix/lang-eval.nix and `just docs-refresh-lang-matrix'):
;;   emacs -Q --batch -L <this dir> -l jotain-lang-doc.el
;; with JOTAIN_LANG_DOC_OUT set to the .mdx path to write.
;;
;; Outside lisp/ and test/ on purpose (see jotain-lang-registry.el).

;;; Code:

(require 'jotain-lang-registry)
(require 'seq)
(require 'subr-x)

(defconst jotain-lang-doc--frontmatter
  "---
title: Language Support
description: Which editor features Jotain wires up for each supported language
---

{/* Auto-generated by nix/lang-eval.nix from etc/lang-eval/jotain-lang-registry.el. */}
{/* Refresh with `just docs-refresh-lang-matrix`. The flake check `lang-eval-doc-in-sync` verifies this file matches the registry. */}

")

(defconst jotain-lang-doc--intro
  "# Language Support

Jotain gives every programming language the same **baseline** the moment its
buffer opens — no language server required:

- **Completion** — in-buffer completion via corfu + cape (dabbrev, file, keyword).
- **Diagnostics** — on-the-fly checking via flymake.
- **Documentation** — echo-area docs via eldoc.
- **Navigation** — xref, imenu, tree-sitter code folding, and a breadcrumb header line.
- **Formatting on save** — via apheleia, where a formatter is configured (below).
- **Editing hygiene** — editorconfig, indentation detection (dtrt-indent), and snippets (tempel).

When a language server is on the project's `PATH` (Jotain resolves servers from
the project's own devenv/environment, not from this config), eglot starts
automatically and **upgrades** completion, documentation, navigation, and
diagnostics to semantic LSP, and adds go-to-definition into dependencies,
find-references, rename, code actions, and workspace-symbol search. Debugging is
provided by dape for the languages with a DAP adapter below.

The table lists the language-specific wiring on top of that baseline. It is the
*declared* standard from the language registry; the live, ground-truth matrix
(actual mode routing and which servers are bundled/available) is produced by
`nix build .#lang-eval-matrix`, and a live end-to-end LSP probe by
`nix build .#lang-eval-live`.

")

(defun jotain-lang-doc--server-cell (entry)
  "Render ENTRY's language-server cell."
  (let ((servers (plist-get entry :servers)))
    (if (not servers)
        "—"
      (concat (mapconcat (lambda (s) (format "`%s`" s)) servers " / ")
              (if (plist-get entry :override) " ᵉ" "")))))

(defun jotain-lang-doc--yn (v) (if v "✓" "—"))

(defun jotain-lang-doc--row (entry)
  "Render one registry ENTRY as a Markdown table row."
  (format "| %s | `%s` | %s | %s | %s | %s | %s | %s | %s |"
          (plist-get entry :name)
          (plist-get entry :mode)
          (if (plist-get entry :grammar) "✓" "—")
          (jotain-lang-doc--server-cell entry)
          (if (plist-get entry :formatter) (format "`%s`" (plist-get entry :formatter)) "—")
          (if (plist-get entry :dape) (format "`%s`" (plist-get entry :dape)) "—")
          (jotain-lang-doc--yn (plist-get entry :snippets))
          (jotain-lang-doc--yn (plist-get entry :inlay))
          (jotain-lang-doc--yn (plist-get entry :live))))

(defun jotain-lang-doc-render ()
  "Return the full language-support .mdx as a string."
  (concat
   jotain-lang-doc--frontmatter
   jotain-lang-doc--intro
   "| Language | Major mode | Tree-sitter | Language server | Formatter | Debug (DAP) | Snippets | Inlay | Live-probed |\n"
   "| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n"
   (mapconcat #'jotain-lang-doc--row jotain-lang-registry "\n")
   "\n\n"
   "Notes: **ᵉ** marks a server set by an explicit `eglot-server-programs` "
   "override in `init-prog.el` (the rest are eglot's built-in defaults). "
   "**Live-probed** ✓ marks the curated subset checked end-to-end by "
   "`.#lang-eval-live`. Tree-sitter ✓ means a grammar backs the major mode "
   "(all grammars ship with the distribution). "
   "This page is generated from `etc/lang-eval/jotain-lang-registry.el` — "
   "edit the registry, not this file, then run `just docs-refresh-lang-matrix`.\n"))

(defun jotain-lang-doc-batch ()
  "Write the rendered .mdx to JOTAIN_LANG_DOC_OUT."
  (let ((out (or (getenv "JOTAIN_LANG_DOC_OUT")
                 (error "JOTAIN_LANG_DOC_OUT is not set"))))
    (with-temp-file out (insert (jotain-lang-doc-render)))
    (message "jotain-lang-doc: wrote %s" out)))

(when (and noninteractive (getenv "JOTAIN_LANG_DOC_OUT"))
  (jotain-lang-doc-batch))

(provide 'jotain-lang-doc)
;;; jotain-lang-doc.el ends here
