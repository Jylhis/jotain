{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${CLAUDE_CODE_REMOTE:-}\" = \"true\" ]; then bash \"$CLAUDE_PROJECT_DIR\"/scripts/bootstrap-agent-env.sh; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(nix build:*)",
      "Bash(nix eval:*)",
      "Bash(nix flake:*)",
      "Bash(nix fmt:*)",
      "Bash(nix run nixpkgs#just:*)",
      "Bash(nix-instantiate --eval:*)",
      "Bash(just:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(jq:*)"
    ]
  }
}
